      "types": [
        {
          "name": "Calculator_InputParams_t",
          "comment": "每通道 HRTIM 工作周期参数 (Calculator 侧独立 typedef)",
          "fields": [
            {"name": "start", "type": "uint16_t", "comment": "HRTIM 开始点"},
