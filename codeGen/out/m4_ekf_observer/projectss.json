  "pipes": [
    {
      "id": "pipe_appadc_apppower",
      "from": "AppAdc",
      "to": "AppPower",
      "callback_type": "pull",
      "comment": "ADC → Power: 电压/电流/相位等功率控制参数",
      "out_link": { "style": "array", "array_size": 4 },
      "in_link": { "style": "array", "array_size": 4 },
      "fields": [
        {"name": "voltage", "type": "uint16_t", "comment": "母线电压 ADC"},
        {"name": "current", "type": "uint16_t", "comment": "每炉头谐振电流 ADC"},
        {"name": "igbt", "type": "uint16_t", "comment": "IGBT 温度 ADC"},
        {"name": "bottom", "type": "uint16_t", "comment": "炉面温度 ADC"},
        {"name": "phase", "type": "uint16_t", "comment": "每炉头相位 ADC"}
      ]
    },
    {
      "id": "pipe_appadc_calculator",
      "from": "AppAdc",
      "to": "Calculator",
      "callback_type": "pull",
      "comment": "ADC → Calculator: 谐振电流/HRTIM 时序原始数据",
      "out_link": { "style": "pointer", "array_size": 0 },
      "in_link": { "style": "pointer", "array_size": 0 },
      "fields": [
        {"name": "resonant_current", "type": "uint16_t**", "comment": "谐振电流 ADC 数组指针数组"},
        {"name": "hrtim_values", "type": "uint16_t**", "comment": "HRTIM 时间戳数组指针数组"},
        {"name": "voltage_data", "type": "uint16_t**", "comment": "母线电压数组指针数组"},
        {"name": "input", "type": "AppAdc_OutputParams_t*", "comment": "每通道 HRTIM 工作周期参数 (AppAdc 侧独立 typedef)"}
      ]
    },
    {
      "id": "pipe_calculator_elecparams",
      "from": "Calculator",
      "to": "ElecParams",
      "callback_type": "pull",
      "comment": "Calculator → ElecParams: 电流积分/电压/过零点等中间结果",
      "out_link": { "style": "array", "array_size": 80 },
      "in_link": { "style": "array", "array_size": 80 },
      "fields": [
        {"name": "hrtim_highOff", "type": "uint16_t", "comment": "上管关断 HRTIM 值"},
        {"name": "hrtim_lowOff", "type": "uint16_t", "comment": "下管关断 HRTIM 值"},
        {"name": "hrtim_highOn", "type": "uint16_t", "comment": "上管开通 HRTIM 值"},
        {"name": "hrtim_lowOn", "type": "uint16_t", "comment": "下管开通 HRTIM 值"},
        {"name": "peak_current", "type": "uint16_t", "comment": "峰值电流 ADC"},
        {"name": "active_current_sum_high", "type": "uint32_t", "comment": "上管电流积分和"},
        {"name": "active_current_sum_low", "type": "uint32_t", "comment": "下管电流积分和"},
        {"name": "voltage_sum", "type": "uint32_t", "comment": "电压原始累加"},
        {"name": "voltage_count", "type": "uint16_t", "comment": "电压累加计数"},
        {"name": "zero_cross_high", "type": "uint16_t", "comment": "上管过零点"},
        {"name": "zero_cross_low", "type": "uint16_t", "comment": "下管过零点"},
        {"name": "peak_point", "type": "uint16_t", "comment": "峰值点 HRTIM 值"}
      ]
    },
    {
      "id": "pipe_calculator_appadc",
      "from": "Calculator",
      "to": "AppAdc",
      "callback_type": "pull",
      "comment": "Calculator → AppAdc: 20ms 周期累积平均值 (谐振电流/电压/相位角)",
      "out_link": { "style": "array", "array_size": 80 },
      "in_link": { "style": "array", "array_size": 80 },
      "fields": [
        {"name": "resonant_current", "type": "int32_t", "comment": "谐振电流均值 (0.01A)"},
        {"name": "voltage", "type": "int32_t", "comment": "母线电压均值 (0.01V)"},
        {"name": "phase_angle", "type": "int32_t", "comment": "相位角 (0.01°)"}
      ]
    },
    {
      "id": "pipe_elecparams_ekflkf",
      "from": "ElecParams",
      "to": "EKF_LKF",
      "callback_type": "pull",
      "comment": "ElecParams → EKF: 电参数观测值",
      "out_link": { "style": "array", "array_size": 4 },
      "in_link": { "style": "array", "array_size": 4 },
      "fields": [
        {"name": "valid", "type": "uint8_t", "comment": "数据有效性"},
        {"name": "I_peak_A", "type": "int32_t", "comment": "峰值电流 (0.01A)"},
        {"name": "Vdc_mean", "type": "int32_t", "comment": "母线电压均值 (0.01V)"},
        {"name": "phi_deg", "type": "int32_t", "comment": "相位角 (0.01°)"},
        {"name": "L_uH", "type": "int32_t", "comment": "等效电感 (0.01μH)"},
        {"name": "f_res_kHz", "type": "int32_t", "comment": "谐振频率 (0.01kHz)"},
        {"name": "R_ohm", "type": "int32_t", "comment": "等效电阻 (0.01Ω)"},
        {"name": "f_sw_Hz", "type": "int32_t", "comment": "开关频率 (0.01Hz)"},
        {"name": "P_W", "type": "int32_t", "comment": "有功功率 (0.01W)"},
        {"name": "Q_factor", "type": "int32_t", "comment": "品质因数 (0.01)"}
      ]
    },
    {
      "id": "pipe_elecparams_apppower",
      "from": "ElecParams",
      "to": "AppPower",
      "callback_type": "pull",
      "comment": "ElecParams → AppPower: 电参数计算结果 (含阻抗/有效值)",
      "out_link": { "style": "array", "array_size": 4 },
      "in_link": { "style": "array", "array_size": 4 },
      "fields": [
        {"name": "valid", "type": "uint8_t", "comment": "数据有效性"},
        {"name": "I_peak_A", "type": "int32_t", "comment": "峰值电流 (0.01A)"},
        {"name": "Vdc_mean", "type": "int32_t", "comment": "母线电压均值 (0.01V)"},
        {"name": "phi_deg", "type": "int32_t", "comment": "相位角 (0.01°)"},
        {"name": "L_uH", "type": "int32_t", "comment": "等效电感 (0.01μH)"},
        {"name": "f_res_kHz", "type": "int32_t", "comment": "谐振频率 (0.01kHz)"},
        {"name": "R_ohm", "type": "int32_t", "comment": "等效电阻 (0.01Ω)"},
        {"name": "f_sw_Hz", "type": "int32_t", "comment": "开关频率 (0.01Hz)"},
        {"name": "P_W", "type": "int32_t", "comment": "有功功率 (0.01W)"},
        {"name": "Q_factor", "type": "int32_t", "comment": "品质因数 (0.01)"},
        {"name": "I_rms", "type": "int32_t", "comment": "电流有效值 (A) — I_rms = I_peak × √2/2"},
        {"name": "Z_mag_ohm", "type": "int32_t", "comment": "阻抗模 (Ω) — Z = √(R² + X²)"},
        {"name": "X_ohm", "type": "int32_t", "comment": "净电抗 (Ω) — X = X_L - X_C"}
      ]
    },
    {
      "id": "pipe_ekflkf_apppower",
      "from": "EKF_LKF",
      "to": "AppPower",
      "callback_type": "pull",
      "comment": "EKF → Power: 卡尔曼滤波后的负载参数 (R/L/f_res)",
      "out_link": { "style": "array", "array_size": 4 },
      "in_link": { "style": "array", "array_size": 4 },
      "fields": [
        {"name": "R_ohm", "type": "int32_t", "comment": "等效电阻 (0.01Ω)"},
        {"name": "L_uH", "type": "int32_t", "comment": "等效电感 (0.01μH)"},
        {"name": "f_res_kHz", "type": "int32_t", "comment": "谐振频率 (0.01kHz)"},
        {"name": "Q_factor", "type": "int32_t", "comment": "品质因数 (0.01)"},
        {"name": "valid", "type": "uint8_t", "comment": "数据有效性"}
      ]
    }
  ],

  "slot_order": [
    "AppAdc",
    "AppPower",
    "Calculator",
    "ElecParams",
    "EKF_LKF"
  ],

  "slot_chains": [
    {
      "name": "Slot1",
      "comment": "1ms 实时控制: AppAdc → AppPower",
      "modules": ["AppAdc", "AppPower"]
    },
    {
      "name": "TK",
      "comment": "20ms 周期: Calculator → ElecParams → EKF_LKF",
      "modules": ["Calculator", "ElecParams", "EKF_LKF"]
    }
  ]
