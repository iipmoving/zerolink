            {"name": "lowOn", "type": "uint16_t", "comment": "死区后低端开通"},
            {"name": "lowOff", "type": "uint16_t", "comment": "低端关闭 (prioed PPG 周期)"},
            {"name": "zero_cross_high", "type": "uint16_t", "comment": "高端过零点索引"},
            {"name": "zero_cross_low", "type": "uint16_t", "comment": "低端过零点索引"},
            {"name": "perAdc", "type": "uint16_t", "comment": "每个 ADC 对应的 HRTIM 值"}
          ]
        }
      ]
    },
    {
      "id": "elecparams",
      "name": "ElecParams",
      "layer": "base_class",
      "source_file": "src/RX32G410_FW_HAL_V1.3N/Projects/BaseClass/src/elec_params.c",
      "comment": "电参数计算 — 20ms 周期计算 I_peak/L/f_res/Q/R/P 等",
