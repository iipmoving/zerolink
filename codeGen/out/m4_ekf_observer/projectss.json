    {
      "id": "apppower",
      "name": "AppPower",
      "layer": "app",
      "source_file": "src/RX32G410_FW_HAL_V1.3N/Projects/LIB/APP/app_power.c",
      "comment": "功率控制 PID — 从 AppAdc/Calculator/EKF_LKF 拉取数据"
    }
