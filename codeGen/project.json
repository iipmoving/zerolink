    {
      "id": "drvkey",
      "name": "DrvKey",
      "layer": "drv",
      "source_file": "drv/drv_key.c",
      "comment": "按键扫描与事件分发 — 输出按键事件到 Hmi/Cooking/SegAlign"
    },
    {
      "id": "appcommmgr",
      "name": "AppCommMgr",
      "layer": "app",
      "source_file": "app/app_comm_mgr.c",
      "comment": "Modbus 通信轮询调度器 — 分发寄存器数据到 Power/Cooking/Protect"
    },
    {
      "id": "appprotect",
      "name": "AppProtect",
      "layer": "app",
      "source_file": "app/app_protect.c",
      "comment": "故障保护逻辑 — 从 CommMgr 获取寄存器，输出故障状态到 Power"
    },
    {
      "id": "appcooking",
      "name": "AppCooking",
      "layer": "app",
      "source_file": "app/app_cooking.c",
      "comment": "烹饪流程控制 — 从 Key/CommMgr 输入，输出烹饪状态到 Power"
    },
    {
      "id": "apppower",
      "name": "AppPower",
      "layer": "app",
      "source_file": "app/app_power.c",
      "comment": "功率控制 PID — 聚合 CommMgr/Protect/Cooking 输入，输出功率命令到 CommMgr 和状态到 Hmi"
    },
    {
      "id": "apphmi",
      "name": "AppHmi",
      "layer": "app",
      "source_file": "app/app_hmi.c",
      "comment": "人机交互逻辑 — 从 Key/Power 输入，输出显示到 Display 和蜂鸣到 Buzzer"
    },
    {
      "id": "appsegalign",
      "name": "AppSegAlign",
      "layer": "app",
      "source_file": "app/app_seg_align.c",
      "comment": "段码对齐处理 — 从 Key 输入，无输出"
    },
    {
      "id": "drvdisplay",
      "name": "DrvDisplay",
      "layer": "drv",
      "source_file": "drv/drv_display.c",
      "comment": "显示驱动 — 从 Hmi 接收显示数据，驱动段码/LED"
    },
    {
      "id": "drvbuzzer",
      "name": "DrvBuzzer",
      "layer": "drv",
