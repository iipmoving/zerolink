//******************************************************************


#if 0
INT8U s_power_equ_control(INT16U t_power_adc_trig)
{

	
	INT16U t_delta_power_adc;
	
	INT16U t_dead_power;
	INT8U  t_ppg_add,t_ppg_dic; 
