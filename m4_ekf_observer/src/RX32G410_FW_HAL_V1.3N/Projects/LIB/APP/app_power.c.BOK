	{
		return ;	
	}
	
	t_power_div=getMaxPowerDiv();	//得到钢锅限制功率值

	t_phase_div=PotPowerM>>3;		//potpowerm高4位*2+0x10
	t_phase_div+=0X10;
	t_phase_div=MinPhase+t_phase_div;
	
