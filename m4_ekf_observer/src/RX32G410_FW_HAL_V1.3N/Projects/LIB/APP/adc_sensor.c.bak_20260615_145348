/* ================================================================
 * ========== 纯算法函数 (Pure Algorithm) ==========
 * 
 * 特征：
 *   - 仅操作内存数据，无硬件API调用
 *   - 纯数学计算/数据处理逻辑
 *   - 可独立单元测试，与硬件解耦
 * ============================================================== */

/* -------------------------- 平均计算 -------------------------- */

/**
 * @brief TXA谐振电流平均值与功率计算
 * 
 * 功能：
 *   1. 遍历采样数据，累加TXA电流、电压、Q值、相位
 *   2. 计算功率（电压×电流）
 *   3. 应用一阶低通滤波
 *   
 * @param ch 炉头通道索引 (0-3)
 */
static void APP_ADC_TxaAvgSum(uint8_t ch)
{
    uint32_t txaValue[5];
    uint32_t newValue[5] = {0, 0, 0, 0, 0};
    uint32_t oldValue[5];
    uint64_t powerSum = 0;

    for (uint8_t num = 1; num < TxaAvageCount - 1; num++) {
        uint8_t num10 = num % 10;

        txaValue[0] = AdcFromApiDma20ms.Txa[ch][num];
        newValue[0] += txaValue[0];

        txaValue[2] = AdcFromApiDma20ms.voltage[ch][num];
        newValue[2] += txaValue[2];

        uint64_t newPower = (uint64_t)txaValue[0] * txaValue[2];
        powerSum += newPower;

        if (num10 >= 4 && num10 <= 5) {
            txaValue[3] = AdcFromApiDma20ms.ceilQ[ch][num];
            newValue[3] += txaValue[3];

            txaValue[4] = AdcFromApiDma20ms.phase[ch][num];
            newValue[4] += txaValue[4];
        }
    }

    txaValue[0] = AdcFromApiDma20ms.Txa[ch][10];
    txaValue[0] <<= 1;
    newValue[0] += txaValue[0];
    newValue[0] /= TxaAvageCount;

    txaValue[2] = AdcFromApiDma20ms.voltage[ch][10];
    txaValue[2] <<= 1;
    newValue[2] += txaValue[2];
    newValue[2] /= TxaAvageCount;

    powerSum += (uint64_t)txaValue[0] * txaValue[2];
    powerSum /= 20;

    newValue[3] /= 4;
    newValue[4] /= 4;

    AdcAverage20ms[AdcGroupPower1 + ch] = (uint32_t)(powerSum >> 4);

    if (AdcAverage20ms[AdcGroupT1A + ch] == 0) {
        oldValue[0] = newValue[0];
    } else {
        oldValue[0]  = AdcAverage20ms[AdcGroupT1A + ch] * (DIV_BASE - DIV_VALUE);
        oldValue[0] += newValue[0] * DIV_VALUE;
        oldValue[0] /= DIV_BASE;
    }
    AdcAverage20ms[AdcGroupT1A + ch] = oldValue[0];

    if (AdcAverage20ms[AdcGroupPhaseDown1 + ch] == 0) {
        oldValue[2] = newValue[2];
    } else {
        oldValue[2]  = AdcAverage20ms[AdcGroupPhaseDown1 + ch] * (DIV_BASE_POWER - DIV_VALUE_POWER);
        oldValue[2] += newValue[2] * DIV_VALUE_POWER;
        oldValue[2] /= DIV_BASE_POWER;
    }
    AdcAverage20ms[AdcGroupPhaseDown1 + ch] = oldValue[2];

    if (AdcAverage20ms[AdcGroupCeilQ1 + ch] == 0) {
        oldValue[3] = newValue[3];
    } else {
        oldValue[3]  = AdcAverage20ms[AdcGroupCeilQ1 + ch] * (DIV_BASE_Q - DIV_VALUE_Q);
        oldValue[3] += newValue[3] * DIV_VALUE_Q;
        oldValue[3] /= DIV_BASE_Q;
    }
    AdcAverage20ms[AdcGroupCeilQ1 + ch] = oldValue[3];

    if (AdcAverage20ms[AdcGroupPhase1 + ch] == 0) {
        oldValue[4] = newValue[4];
    } else {
        oldValue[4]  = AdcAverage20ms[AdcGroupPhase1 + ch] * (DIV_BASE_Q - DIV_VALUE_Q);
        oldValue[4] += newValue[4] * DIV_VALUE_Q;
        oldValue[4] /= DIV_BASE_Q;
    }
    AdcAverage20ms[AdcGroupPhase1 + ch] = oldValue[4];
}

/**
 * @brief 20ms ADC数据平均汇总主函数
 * 
 * 功能：
 *   1. 检查是否有新数据
 *   2. 计算电压平均值
 *   3. 调用TXA平均计算（4个炉头）
 *   4. 拷贝温度传感器数据
 *   5. 设置20ms完成标志
 */
static void APP_ADC_AVG_Fun(void)
{
    if (AdcFromApiDma20ms.num == 0)
        return;

    AdcFromApiDma20ms.num = 0;

    for (uint8_t i = 0; i < AdcAvageCount; i++) {
        AdcAverage20ms[AdcGroupVoltage] += Tempe_ADC_DmaBuff.Vc[i];
    }
    AdcAverage20ms[AdcGroupVoltage] /= AdcAvageCount;

    APP_ADC_TxaAvgSum(0);
    APP_ADC_TxaAvgSum(1);
    APP_ADC_TxaAvgSum(2);
    APP_ADC_TxaAvgSum(3);

    AdcAverage20ms[AdcGroupIgbt1] = AdcFromApiDma20ms.Tempe.buff[Igbt1ADC2_GroupZero];
    AdcAverage20ms[AdcGroupIgbt2] = AdcFromApiDma20ms.Tempe.buff[Igbt2ADC2_GroupZero];
    AdcAverage20ms[AdcGroupIgbt3] = AdcFromApiDma20ms.Tempe.buff[Igbt3ADC2_GroupZero];
    AdcAverage20ms[AdcGroupIgbt4] = AdcFromApiDma20ms.Tempe.buff[Igbt4ADC2_GroupZero];

    AdcAverage20ms[AdcGroupBottom1] = AdcFromApiDma20ms.Tempe.buff[Bottom1ADC1_GroupZero];
    AdcAverage20ms[AdcGroupBottom2] = AdcFromApiDma20ms.Tempe.buff[Bottom2ADC1_GroupZero];
    AdcAverage20ms[AdcGroupBottom3] = AdcFromApiDma20ms.Tempe.buff[Bottom3ADC1_GroupZero];
    AdcAverage20ms[AdcGroupBottom4] = AdcFromApiDma20ms.Tempe.buff[Bottom4ADC1_GroupZero];

    if (Adc20msCount >= AdcAvageCount)
        IcVc20msOccur = 1;
}

