{
    uint16_t count = AdcFromApiDma20ms.count;

    if (TxA_ADC_AdcDmaBuff.step == TXA_StepDmaEnd) {
        TxA_ADC_AdcDmaBuff.step = TXA_StepStart;
        AdcFromApiDma20ms.count++;

        if (AdcFromApiDma20ms.count <= 20 ) {
