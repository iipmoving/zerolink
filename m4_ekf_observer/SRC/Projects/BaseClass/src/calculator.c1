#include "include/calculator_io.h"

MODULE_SKELETON(Calculator);

/* 管道就绪标志: 每 BIT 代表一个管道的 ST_NEW 状态 */
typedef union {
    uint8_t all;           /* 全零 = 无数据就绪，跳过本次 */
    struct {
        uint8_t appadc   : 1;  /* AppAdc 数据就绪 */
    } bits;
} Calculator_PipeFlags_t;

// ===== [USER CODE] =====
// >>> 用户常量、变量、业务函数
// 此区域由用户维护，AI 重生成时保留

// 用户业务函数 — by ProcessInput 调用
void Calculator_Process(MODULE_INPUT(Calculator) *in, MODULE_OUTPUT(Calculator) *out, Calculator_PipeFlags_t flags)
{
    if (flags.bits.appadc) { /* 处理 AppAdc 输入 */ }
    /* TODO: 写入 ElecParams, AppPower 输出 */
}

// >>> 用户常量
// #define CALCULATOR_THRESHOLD  100

// >>> 用户变量
// static uint32_t s_calculator_counter;

// ===== [END USER CODE] =====

// ===== [AI GENERATED] — 每次重生成 ===== 

static void Init(void)
{
    g_input.para  = &s_inPara;
    g_output.para = &s_outPara;

    userInit();     // >>> [USER: 统一初始化入口]
}

static void ProcessInput(void)
{
    MODULE_INPUT(Calculator) *in = (MODULE_INPUT(Calculator)*)g_input.para;
    MODULE_OUTPUT(Calculator) *out = (MODULE_OUTPUT(Calculator)*)g_output.para;

    /* === 输入段: 数据有效检查 === */
    if (!in) return;
    Calculator_PipeFlags_t flags = {0};
    flags.bits.appadc = (in->AppAdc_params->status & ST_NEW) ? 1 : 0;
    if (!flags.all) return;

    /* === 计算段: 用户业务 === */
    Calculator_Process(in, out, flags);

    /* === 输出段: 状态管理 === */
    in->AppAdc_params->status  &= ~ST_NEW;  /* 消费完成 */
    out->ElecParams_params.status |= ST_OUT;  /* 输出就绪 */
    out->AppPower_params.status |= ST_OUT;  /* 输出就绪 */
}

MODULE_EXPORT(Calculator);

