      },
      "in_link": {
        "style": "array",
        "dims": "[4]"
      },
      "fields": [
        {
          "name": "I_peak_A",
          "type": "float",
          "comment": "峰值电流 (A) — 中值滤波 + 权重修正后"
        },
        {
          "name": "Vdc_mean",
          "type": "float",
          "comment": "母线电压均值 (V) — 20ms周期ADC值中值"
        },
        {
          "name": "phi_deg",
          "type": "float",
          "comment": "相位角 (度) — 高电流周期平均"
        },
        {
          "name": "f_sw_Hz",
          "type": "float",
          "comment": "开关频率 (Hz) — HRTIM_CLK/lowOff"
        },
        {
          "name": "L_uH",
          "type": "float",
          "comment": "等效电感 (μH) — 基波等效电路法 + 权重修正"
        },
        {
          "name": "f_res_kHz",
          "type": "float",
          "comment": "谐振频率 (kHz) — f_res = 1/(2π√(LC))"
        },
        {
          "name": "Q_factor",
          "type": "float",
          "comment": "品质因数 — Q = tan(φ)/(f_sw/f_res - f_res/f_sw)"
        },
        {
          "name": "R_ohm",
          "type": "float",
          "comment": "等效电阻 (Ω) — R = ωL/Q"
        },
        {
          "name": "I_rms",
          "type": "float",
          "comment": "电流有效值 (A) — I_rms = I_peak × √2/2"
        },
        {
          "name": "P_W",
          "type": "float",
          "comment": "有功功率 (W) — P = median(I_active × Vdc)"
        },
        {
          "name": "Z_mag_ohm",
          "type": "float",
          "comment": "阻抗模 (Ω) — Z = √(R² + X²)"
        },
        {
          "name": "X_ohm",
          "type": "float",
          "comment": "净电抗 (Ω) — X = X_L - X_C"
        },
        {
          "name": "valid",
          "type": "uint8_t",
          "comment": "计算有效性标志 — 1=有效, 0=无效"
        },
        {
          "name": "res[3]",
          "type": "uint8_t",
          "comment": "保留字节，对齐填充"
        }
      ],
